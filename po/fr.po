msgstr "Esprit restant : {n}. ENTRÉE — relevez-vous et combattez"

msgid "No spirit left. ENTER — restart the chapter"
msgstr "Plus d'esprit. ENTRÉE — recommencer le chapitre"

msgid "ESC — main menu"
