msgstr "Dźwięk: {state}"

msgid "Music: {state}"
msgstr "Muzyka: {state}"

msgid "Fullscreen: {state}"
msgstr "Pełny ekran: {state}"

msgid "Quit"
msgstr "Wyjdź"

msgid "ARROWS — choose    ENTER — confirm    F11 — fullscreen"
msgstr "STRZAŁKI — wybór    ENTER — zatwierdź    F11 — pełny ekran"

msgid "Move"
msgstr "Ruch"

msgid "Left stick / D-pad"
msgstr "Lewa gałka / krzyżak"

msgid "Crouch"
msgstr "Kucnięcie"

msgid "Punch"
msgstr "Cios ręką"

msgid "Kick  (Up + kick — high kick)"
msgstr "Kopnięcie  (Góra + kopnięcie — wysokie)"

msgid "Block (hold; crouch + block — low guard)"
msgstr "Blok (przytrzymaj; kucnięcie + blok — niska garda)"

msgid "Pause"
msgstr "Pauza"

msgid "Keyboard"
msgstr "Klawiatura"

msgid "Gamepad"
msgstr "Pad"

msgid "New techniques are learned as the journey goes on."
msgstr "Nowych technik nauczysz się w trakcie podróży."

msgid "Press any key to return"
msgstr "Naciśnij dowolny klawisz, aby wrócić"

msgid "THE END"
msgstr "KONIEC"

msgid "Score: {n}"
msgstr "Wynik: {n}"

msgid "NEW HIGH SCORE!"
msgstr "NOWY REKORD!"

msgid "Thank you for playing."
msgstr "Dziękujemy za grę."

msgid "Press ENTER"
msgstr "Naciśnij ENTER"

msgid "Chapter {n}"
msgstr "Rozdział {n}"

msgid "Epilogue"
msgstr "Epilog"

msgid "ENTER — continue"
msgstr "ENTER — dalej"

msgid "Chapter complete!"
msgstr "Rozdział ukończony!"

msgid "New technique learned"
msgstr "Nowa technika opanowana"

msgid "You"
msgstr "Ty"

msgid "Focus"
msgstr "Skupienie"

msgid "Score"
msgstr "Wynik"

msgid "Right — walk    J punch    K kick    hold L — block    Down — crouch"
msgstr "Prawo — idź    J ręka    K noga    trzymaj L — blok    Dół — kucnij"

msgid "The Bamboo Grove"
msgstr "Bambusowy gaj"

msgid "The River Gorge"
msgstr "Wąwóz rzeki"

msgid "The Rain Monastery"
msgstr "Klasztor Deszczu"

msgid "The Snow Pass"
msgstr "Śnieżna przełęcz"

msgid "The Ember Temple"
msgstr "Ognista świątynia"

msgid "The Summit of Seven Winds"
msgstr "Szczyt Siedmiu Wiatrów"

msgid "Brigand"
msgstr "Zbój"

msgid "Brute"
msgstr "Osiłek"

msgid "Lancer"
msgstr "Włócznik"

msgid "Shade"
msgstr "Cień"

msgid "Monk"
msgstr "Mnich"

msgid "Bamboo Fang"
msgstr "Bambusowy Kieł"

msgid "Bridge Keeper"
msgstr "Strażnik Mostu"

msgid "Abbot of Rain"
msgstr "Opat Deszczu"

msgid "White Wolf"
msgstr "Biały Wilk"

msgid "Ember General"
msgstr "Ognisty Generał"

msgid "The Warlord"
msgstr "Władca"
